{
  "cibles": [
    {
      "id": "systeme_apt",
      "titre": "Systeme apt",
      "description": "Mise a jour globale Debian/Raspberry Pi OS via apt full-upgrade.",
      "type": "systeme_apt",
      "commande_version_installee": [
        "sh",
        "-lc",
        ". /etc/os-release && printf '%s (%s)\\n' \"${PRETTY_NAME:-Systeme inconnu}\" \"${VERSION_ID:-?}\""
      ],
      "commandes_migration": [
        [
          "apt-get",
          "update"
        ],
        [
          "apt-get",
          "full-upgrade",
          "-y"
        ]
      ]
    },
    {
